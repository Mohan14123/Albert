APP_NAME=AI Personal Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://assistant:change_me@localhost:5432/assistant
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change_me
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
RABBITMQ_URL=amqp://assistant:change_me@localhost:5672/
RABBITMQ_EXCHANGE=assistant.exchange

JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASHER=argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
TOKEN_ENCRYPTION_KEY=replace_with_a_valid_32_byte_base64_fernet_key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/callback

AI_SERVICE_URL=http://localhost:8001
AI_API_KEY=
AI_REQUEST_TIMEOUT=120
FILE_STORAGE=local
UPLOAD_DIRECTORY=uploads/

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=100/minute
ENABLE_VOICE=false
ENABLE_FILE_UPLOAD=true
ENABLE_NOTIFICATIONS=false
ENABLE_MEMORY=true
ENABLE_RAG=true
