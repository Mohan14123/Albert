# Database Configuration
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change_me

# Redis Configuration
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=assistant
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=super_secret_jwt_key_that_must_be_at_least_32_characters_long
TOKEN_ENCRYPTION_KEY=your_encryption_key_here

# OpenAI Integration
AI_API_KEY=your_openai_api_key_here
AI_SERVICE_URL=http://localhost:8001/api/v1
DATABASE_URL=postgresql+asyncpg://assistant:change_me@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://assistant:change_me@rabbitmq:5672/
